# Firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# PIN that gates access to /admin (client-side check only — see the note in
# firestore.rules about this not being real auth yet). Leave unset locally and
# /admin is wide open with a warning banner; set a real PIN before deploying.
ADMIN_PIN=

# Cloudinary — uploads are signed server-side, so the API key/secret never
# reach the browser. Get these from the Cloudinary console's Dashboard page.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp store number, digits only with country code, e.g. 233555000111
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=
